---
import Layout from '../layouts/Layout.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';
---

<Layout title="Plantopia">
  <main class="mx-auto min-h-screen max-w-3xl px-4 py-8">
    <header class="mb-8 flex items-center gap-2">
      <span class="text-2xl">🌿</span>
      <h1 class="text-xl font-semibold">Plantopia</h1>
    </header>

    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-lg font-medium">Mis plantas</h2>
      <a
        href={`${import.meta.env.BASE_URL}plants/new`}
        class="rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-green-500"
      >
        + Agregar planta
      </a>
    </div>

    <div id="filters" class="hidden mb-4 flex flex-wrap items-center gap-3">
      <select
        id="filter-phase"
        class="rounded-md border border-slate-700 bg-slate-950 px-2 py-1.5 text-sm text-slate-300 outline-none focus:border-green-500"
      >
        <option value="">Todas las fases</option>
      </select>
      <label class="flex items-center gap-1.5 text-sm text-slate-300">
        <input id="filter-attention" type="checkbox" class="rounded border-slate-700 bg-slate-950" />
        ⚠️ Solo necesita atención
      </label>
    </div>

    <div id="loading" class="py-12 text-center text-sm text-slate-500">Cargando plantas…</div>
    <div id="error" class="hidden rounded-md border border-red-900 bg-red-950 px-4 py-3 text-sm text-red-300"></div>
    <div id="empty" class="hidden flex-col items-center gap-3 py-16 text-center">
      <span class="text-4xl">🪴</span>
      <p class="text-slate-400">Todavía no tienes plantas registradas.</p>
      <a href={`${import.meta.env.BASE_URL}plants/new`} class="rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white">
        Agregar tu primera planta
      </a>
    </div>
    <div id="plant-grid" class="hidden grid grid-cols-2 gap-3"></div>
    <p id="filter-empty" class="hidden py-12 text-center text-sm text-slate-500">
      Ninguna planta coincide con el filtro.
    </p>
  </main>

  <BottomNav active="collection" />

  <script>
    import { requireAuth } from '../lib/session';
    import { listPlants } from '../lib/plants';
    import { isCareOverdue, countCareOverdue } from '../lib/plant-status';
    import {
      PHASE_LABELS,
      PHASE_ICONS,
      GROWTH_PHASES,
    } from '../lib/labels';
    import type { PlantWithCatalog } from '../types/catalog';
    import type { GrowthPhase } from '../types/database';

    const loadingEl = document.getElementById('loading')!;
    const errorEl = document.getElementById('error')!;
    const emptyEl = document.getElementById('empty')!;
    const gridEl = document.getElementById('plant-grid')!;
    const filtersEl = document.getElementById('filters')!;
    const filterEmptyEl = document.getElementById('filter-empty')!;
    const filterPhaseEl = document.getElementById('filter-phase') as HTMLSelectElement;
    const filterAttentionEl = document.getElementById('filter-attention') as HTMLInputElement;

    for (const phase of GROWTH_PHASES) {
      const opt = document.createElement('option');
      opt.value = phase;
      opt.textContent = `${PHASE_ICONS[phase]} ${PHASE_LABELS[phase]}`;
      filterPhaseEl.appendChild(opt);
    }

    function card(plant: PlantWithCatalog): string {
      const base = import.meta.env.BASE_URL;
      const displayPhoto = plant.photo_url ?? plant.plant_catalog?.reference_photo_url ?? null;
      const needsAttention = isCareOverdue(plant);

      return `
        <a href="${base}plants/detail?id=${plant.id}" class="group relative block aspect-[4/5] overflow-hidden rounded-xl border border-slate-800 bg-slate-800 transition hover:border-slate-600">
          ${
            displayPhoto
              ? `<img src="${escapeHtml(displayPhoto)}" alt="${escapeHtml(plant.common_name)}" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />`
              : `<div class="absolute inset-0 flex items-center justify-center text-5xl">🪴</div>`
          }
          ${
            needsAttention
              ? `<span class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 text-xs shadow">⚠️</span>`
              : ''
          }
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-3 pt-8">
            <p class="truncate text-sm font-medium text-white">${escapeHtml(plant.common_name)}</p>
            <span class="text-xs text-white/80">${PHASE_ICONS[plant.current_phase]} ${PHASE_LABELS[plant.current_phase]}</span>
          </div>
        </a>
      `;
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Badging API: tipada en lib.dom.d.ts pero el soporte real varía por navegador,
    // por eso el feature-detect en runtime con 'in' antes de llamarla.
    function updateAppBadge(overdueCount: number) {
      if (!('setAppBadge' in navigator) || !('clearAppBadge' in navigator)) return;
      if (overdueCount > 0) {
        navigator.setAppBadge(overdueCount).catch(() => {});
      } else {
        navigator.clearAppBadge().catch(() => {});
      }
    }

    let allPlants: PlantWithCatalog[] = [];

    function applyFilters() {
      const phase = filterPhaseEl.value as GrowthPhase | '';
      const onlyAttention = filterAttentionEl.checked;

      const filtered = allPlants.filter((plant) => {
        if (phase && plant.current_phase !== phase) return false;
        if (onlyAttention && !isCareOverdue(plant)) return false;
        return true;
      });

      if (filtered.length === 0) {
        gridEl.classList.add('hidden');
        gridEl.classList.remove('grid');
        filterEmptyEl.classList.remove('hidden');
        return;
      }

      filterEmptyEl.classList.add('hidden');
      gridEl.innerHTML = filtered.map(card).join('');
      gridEl.classList.remove('hidden');
      gridEl.classList.add('grid');
    }

    filterPhaseEl.addEventListener('change', applyFilters);
    filterAttentionEl.addEventListener('change', applyFilters);

    async function init() {
      const user = await requireAuth();
      if (!user) return;

      try {
        allPlants = await listPlants(user.id);
        loadingEl.classList.add('hidden');
        updateAppBadge(countCareOverdue(allPlants));

        if (allPlants.length === 0) {
          emptyEl.classList.remove('hidden');
          emptyEl.classList.add('flex');
          return;
        }

        filtersEl.classList.remove('hidden');
        applyFilters();
      } catch (err) {
        loadingEl.classList.add('hidden');
        errorEl.classList.remove('hidden');
        errorEl.textContent =
          err instanceof Error ? `Error al cargar plantas: ${err.message}` : 'Error al cargar plantas.';
      }
    }

    init();
  </script>
</Layout>
